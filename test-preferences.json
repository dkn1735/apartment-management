{
  "tool": "junit5+testcontainers",
  "gate": null,
  "additionalTools": ["assertj", "vitest", "@testing-library/react"],
  "e2eTool": "none",
  "testDir": "backend/src/test/java (mirror the main package); frontend: beside the source",
  "filePattern": "*Test.java; frontend: *.test.ts / *.test.tsx",
  "packageManager": "maven (backend), pnpm (frontend)",
  "runCommand": "cd backend && mvnw.cmd verify"
}
