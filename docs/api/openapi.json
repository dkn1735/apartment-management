{
  "openapi" : "3.1.0",
  "info" : {
    "title" : "Hệ thống Quản lý Chung cư API",
    "version" : "v1"
  },
  "servers" : [ {
    "url" : "/"
  } ],
  "security" : [ {
    "csrfHeader" : [ ]
