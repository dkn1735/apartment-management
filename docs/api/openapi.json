{
  "openapi" : "3.1.0",
  "info" : {
    "title" : "Hệ thống Quản lý Chung cư API",
    "version" : "v1"
  },
  "servers" : [ {
    "url" : "/"
  } ],
  "paths" : {
    "/api/v1/auth/login" : {
      "post" : {
        "tags" : [ "Xác thực" ],
        "summary" : "Đăng nhập bằng số điện thoại hoặc email",
        "description" : "Đặt ba cookie HttpOnly: access_token, refresh_token, phien. Body không chứa token.",
        "operationId" : "dangNhap",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/DangNhapRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiResponseDangNhapResponse"
                }
              }
            }
          },
          "default" : {
            "description" : "Lỗi theo vỏ bọc chung",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/profile" : {
      "get" : {
        "tags" : [ "Xác thực" ],
        "summary" : "Hồ sơ của người đang đăng nhập",
        "operationId" : "hoSo",
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiResponseHoSoResponse"
                }
              }
            }
          },
          "default" : {
            "description" : "Lỗi theo vỏ bọc chung",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components" : {
    "schemas" : {
      "DangNhapRequest" : {
        "type" : "object",
        "properties" : {
          "taiKhoan" : {
            "type" : "string",
            "description" : "Số điện thoại hoặc email",
            "maxLength" : 150,
            "minLength" : 0
          },
          "matKhau" : {
            "type" : "string",
            "maxLength" : 128,
            "minLength" : 0
          }
        },
        "required" : [ "matKhau", "taiKhoan" ]
      },
      "ApiResponseDangNhapResponse" : {
        "type" : "object",
        "properties" : {
          "success" : {
            "type" : "boolean"
          },
          "code" : {
            "type" : "integer",
            "format" : "int32"
          },
          "message" : {
            "type" : "string"
          },
          "data" : {
            "$ref" : "#/components/schemas/DangNhapResponse"
          },
          "timestamp" : {
            "type" : "string",
            "format" : "date-time"
          }
        }
      },
      "DangNhapResponse" : {
        "type" : "object",
        "properties" : {
          "maNguoiDung" : {
            "type" : "string"
          },
          "hoTen" : {
            "type" : "string"
          },
          "vaiTro" : {
            "type" : "array",
            "items" : {
              "type" : "string",
              "enum" : [ "QUAN_TRI_VIEN", "BAN_QUAN_LY", "BAN_QUAN_TRI", "KE_TOAN", "KY_THUAT", "BAO_VE", "CU_DAN" ]
            }
          },
          "accessTokenHetHanLuc" : {
            "type" : "string",
            "format" : "date-time"
          }
        },
        "required" : [ "accessTokenHetHanLuc", "hoTen", "maNguoiDung", "vaiTro" ]
      },
      "ApiResponseHoSoResponse" : {
        "type" : "object",
        "properties" : {
          "success" : {
            "type" : "boolean"
          },
          "code" : {
            "type" : "integer",
            "format" : "int32"
          },
          "message" : {
            "type" : "string"
          },
          "data" : {
            "$ref" : "#/components/schemas/HoSoResponse"
          },
          "timestamp" : {
            "type" : "string",
            "format" : "date-time"
          }
        }
      },
      "HoSoResponse" : {
        "type" : "object",
        "properties" : {
          "maNguoiDung" : {
            "type" : "string"
          },
          "hoTen" : {
            "type" : "string"
          },
          "soDienThoai" : {
            "type" : "string"
          },
          "email" : {
            "type" : "string"
          },
          "trangThaiTaiKhoan" : {
            "type" : "string",
            "example" : "Hoạt động"
          },
          "vaiTro" : {
            "type" : "array",
            "items" : {
              "type" : "string",
              "enum" : [ "QUAN_TRI_VIEN", "BAN_QUAN_LY", "BAN_QUAN_TRI", "KE_TOAN", "KY_THUAT", "BAO_VE", "CU_DAN" ]
            }
          }
        },
        "required" : [ "email", "hoTen", "maNguoiDung", "soDienThoai", "trangThaiTaiKhoan", "vaiTro" ]
      },
      "ErrorResponse" : {
        "properties" : {
          "success" : {
            "type" : "boolean"
          },
          "code" : {
            "type" : "integer",
            "format" : "int32"
          },
          "message" : {
            "type" : "string"
          },
          "errorCode" : {
            "type" : "string"
          },
          "errors" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/FieldError"
            }
          },
          "requestId" : {
            "type" : "string"
          },
          "timestamp" : {
            "type" : "string",
            "format" : "date-time"
          }
        }
      },
      "FieldError" : {
        "properties" : {
          "field" : {
            "type" : "string"
          },
          "message" : {
            "type" : "string"
          }
        }
      }
    }
  }
}
