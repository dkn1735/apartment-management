  "paths" : {
    "/api/v1/auth/refresh-token" : {
      "post" : {
        "tags" : [ "Xác thực" ],
        "summary" : "Làm mới phiên bằng cookie refresh_token",
        "description" : "Xoay vòng refresh token và đặt lại ba cookie khi lamMoi là true. Khi lamMoi là false (token vừa được một request khác làm mới), không có cookie mới. Không có body.",
        "operationId" : "lamMoi",
        "parameters" : [ {
          "name" : "refresh_token",
          "in" : "cookie",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiResponseLamMoiPhienResponse"
                }
              }
            }
          },
          "default" : {
            "description" : "Lỗi theo vỏ bọc chung",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/logout" : {
      "post" : {
        "tags" : [ "Xác thực" ],
        "summary" : "Đăng xuất phiên trên máy này",
        "description" : "Thu hồi họ phiên mà cookie refresh_token trỏ tới và xóa ba cookie. Luôn trả 200.",
        "operationId" : "dangXuat",
        "parameters" : [ {
          "name" : "refresh_token",
          "in" : "cookie",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        } ],
