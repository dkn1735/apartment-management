# Sao chép thành backend/.env (không commit). Spring đọc qua spring.config.import.
# seed: nạp tài khoản mẫu (mật khẩu ChungCu@2026); bỏ đi nếu không muốn dữ liệu mẫu
SPRING_PROFILES_ACTIVE=dev,seed
DB_URL=jdbc:postgresql://localhost:5433/chungcu
DB_USERNAME=chungcu
DB_PASSWORD=doi-mat-khau-nay
# Khóa ký access token; bắt buộc, ít nhất 32 byte, phải khác chuỗi mẫu dưới đây
# (backend không khởi động với chuỗi mẫu). Sinh bằng: openssl rand -base64 48
JWT_SECRET=doi-thanh-chuoi-ngau-nhien-du-dai
APP_TIMEZONE=Asia/Ho_Chi_Minh
# Cờ Secure của cookie đăng nhập. Để trống: dev là false, prod là true.
# Chỉ đặt false ở prod khi demo qua http trên mạng LAN.
COOKIE_SECURE=
# Gửi email (spec 0010). Dev để trống: gửi tới Mailpit ở localhost:1025, xem thư ở
# http://localhost:8025. Bản demo dùng Gmail: bật xác minh hai bước rồi tạo App Password.
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
MAIL_USERNAME=
# App Password 16 ký tự của Gmail; bí mật, không commit
MAIL_PASSWORD=
# Với Gmail phải trùng MAIL_USERNAME, có thể kèm tên: Chung cư <ban@gmail.com>
MAIL_FROM=
# URL gốc của frontend để dựng link trong email. Dev để trống: http://localhost:3000
APP_PUBLIC_URL=
