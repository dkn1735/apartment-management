# Sao chép thành .env (không commit). docker compose đọc file này.
POSTGRES_DB=chungcu
POSTGRES_USER=chungcu
POSTGRES_PASSWORD=doi-mat-khau-nay
# Cổng PostgreSQL trên máy; 5433 để không đụng PostgreSQL cài sẵn trên Windows
POSTGRES_PORT=5433

# Chỉ dùng cho docker-compose.prod.yml (bản demo)
# Khóa ký access token: ít nhất 32 byte, phải khác chuỗi mẫu này. Sinh bằng: openssl rand -base64 48
JWT_SECRET=doi-thanh-chuoi-ngau-nhien-du-dai
# Demo qua http (không phải https) trên mạng LAN thì đặt false, nếu không trình duyệt bỏ cookie đăng nhập
COOKIE_SECURE=true
